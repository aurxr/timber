{
  "name": "timbersync-leads",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/tech/server.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "start": "tsx src/tech/server.ts",
    "install:browser": "playwright install chromium"
  },
  "dependencies": {
    "@playwright/test": "^1.61.1",
    "@tanstack/react-table": "^8.21.3",
    "csv-parse": "^7.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^6.46.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
